# Tudo tem padrão; um .env só é necessário para mudar alguma coisa.

# Onde a API escuta. 127.0.0.1 não aceita conexão de fora da máquina.
HOST=127.0.0.1
PORT=3001

# Ritmo da coleta do estado que está sendo visto, em milissegundos (mínimo 1000).
TSE_POLL_MS=1000

# Teto de requisições por segundo ao TSE. O limite publicado por eles é 100 por IP,
# e o código não deixa passar disso. O padrão, 80, deixa margem para o resto da casa.
TSE_MAX_RPS=80

# Estados gravados durante as janelas do TSE, mesmo sem navegador aberto.
# ALL (padrão) grava os 27; "MG,SP" limita. O que não for gravado na hora não se recupera.
RECORD_UFS=ALL

# Códigos de eleição, descobertos sozinhos no ele-c.json do TSE.
# Só preencha com códigos publicados por eles; não reutilize os de 2022/2024.
# TSE_FEDERAL_1=
# TSE_STATE_1=
# TSE_FEDERAL_2=
# TSE_STATE_2=
