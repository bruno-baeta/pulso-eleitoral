{
  "name": "pulso-eleitoral",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && node scripts/compress.mjs",
    "start": "node --import tsx server/index.ts",
    "import:historico": "tsx server/import-historico.ts",
    "import:municipal": "tsx server/import-municipal.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "baseline": "node scripts/baseline.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "shoot": "node scripts/shoot.mjs",
    "data:territorio": "node scripts/territorio-2022.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.3.0",
    "fastify": "^5.12.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
